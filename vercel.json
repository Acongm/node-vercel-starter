{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/v1/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/legacy/(.*)",
      "dest": "/public/legacy/$1"
    },
    {
      "src": "/(.*\\.(js|css|png|ico|svg|json|woff2?|map))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
