APP_NAME=node-vercel-starter
APP_VERSION=0.1.0
PORT=3000
RUNTIME_TARGET=node

# none | memory | file | mongo | postgres | redis | supabase
DATA_MODE=memory
DATA_FILE_PATH=.data/comments.json
CHAT_LOGS_FILE_PATH=.data/chat-logs.json
CHAT_THREADS_FILE_PATH=.data/chat-threads.json
CHAT_MESSAGES_FILE_PATH=.data/chat-messages.json
AUTH_USERS_FILE_PATH=.data/auth-users.json

# Shared with auth packages/config (@acongm/config). Env overrides win.
SITE_CONFIG_PATH=site.config.yaml
# SITE_GIT_PUBLISH_BRANCH=dev
# SITE_LIMIT_ANON_CHAT_PER_DAY=20
# SITE_LIMIT_USER_CHAT_PER_DAY=200
# SITE_OAUTH_PROVIDERS=github,google

# Comma-separated browser origins allowed to call the API.
# Wildcards match one subdomain segment, for example https://admin.acongm.com.
CORS_ORIGINS=https://acongm.com,https://*.acongm.com

# Supabase
SUPABASE_URL=
# Required for new /api/user/* and /api/chats/* routes. This is safe to expose
# to clients and is paired with the user's Authorization: Bearer access token.
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Keep for migrations/admin/background work and legacy adapters.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy compatibility fallback for generic adapters.
SUPABASE_API_KEY=
SUPABASE_REQUEST_SECRET=
SUPABASE_COMMENTS_TABLE=comments
SUPABASE_CHAT_LOGS_TABLE=chat_logs
# Legacy only: local HS256 verification fallback. New auth verifies tokens via
# Supabase Auth getUser(access_token), so new deployments should not need this.
SUPABASE_JWT_SECRET=

# memory | local | vercel-blob | s3
FILE_MODE=memory
UPLOAD_DIR=uploads

# Legacy auth compatibility. New user/chat modules require Supabase Auth.
# none | jwt | external
AUTH_MODE=jwt
AUTH_JWT_SECRET=change-me
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=
AUTH_SESSION_TTL=7d
# Optional legacy API-hosted OAuth. Prefer Supabase Auth providers for new clients.
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_OAUTH_REDIRECT_BASE=https://api.acongm.com
# Legacy seeded users: npx ts-node scripts/seed-auth-user.ts --email a@b.c --password '...'

# mock | openai | custom
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# DeepSeek OpenAI-compatible example:
# AI_PROVIDER=custom
# AI_API_KEY=as-xxx
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-pro

# Optional: enable enableWebSearch in chat APIs
# WEB_SEARCH_API_KEY=
# TAVILY_API_KEY=

# Format: provider=https://api.example.com,other=https://other.example.com
PROXY_ALLOWLIST=
