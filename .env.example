APP_NAME=node-vercel-starter
APP_VERSION=0.1.0
PORT=3000
RUNTIME_TARGET=node

# none | memory | file | mongo | postgres | redis | supabase
DATA_MODE=memory
DATA_FILE_PATH=.data/comments.json
CHAT_LOGS_FILE_PATH=.data/chat-logs.json
CHAT_THREADS_FILE_PATH=.data/chat-threads.json
CHAT_MESSAGES_FILE_PATH=.data/chat-messages.json

# Shared with auth packages/config (@acongm/config). Env overrides win.
SITE_CONFIG_PATH=site.config.yaml
# SITE_GIT_PUBLISH_BRANCH=dev
# SITE_LIMIT_ANON_CHAT_PER_DAY=20
# SITE_LIMIT_USER_CHAT_PER_DAY=200
# SITE_OAUTH_PROVIDERS=github

# Comma-separated browser origins allowed to call the API.
# Wildcards match one subdomain segment, for example https://admin.acongm.com.
CORS_ORIGINS=https://acongm.com,https://*.acongm.com

# Required when DATA_MODE=supabase. Prefer a server-only service role key.
# If a service role key is unavailable, set SUPABASE_API_KEY to a publishable
# or anon key and set SUPABASE_REQUEST_SECRET to match private.api_secrets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_API_KEY=
SUPABASE_REQUEST_SECRET=
SUPABASE_COMMENTS_TABLE=comments
SUPABASE_CHAT_LOGS_TABLE=chat_logs
# HS256 secret used to verify Supabase Auth access tokens (app_metadata.role).
SUPABASE_JWT_SECRET=

# memory | local | vercel-blob | s3
FILE_MODE=memory
UPLOAD_DIR=uploads

# none | jwt | external
AUTH_MODE=jwt
AUTH_JWT_SECRET=change-me
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=
AUTH_SESSION_TTL=7d

# mock | openai | custom
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# DeepSeek OpenAI-compatible example:
# AI_PROVIDER=custom
# AI_API_KEY=as-xxx
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-pro

# Optional: enable enableWebSearch in /api/ai/chat
# WEB_SEARCH_API_KEY=
# TAVILY_API_KEY=

# Format: provider=https://api.example.com,other=https://other.example.com
PROXY_ALLOWLIST=
